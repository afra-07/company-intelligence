# Optional API Keys for Signalpost
# The agent is fully operational in keyless mode using official Norwegian registers.
# Configure one or more keys below only if you wish to enable supplemental LLM extraction or web search.

# Primary LLM Provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Alternative LLM Provider (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Supplemental Web Search (SerpAPI - optional, 100 free searches/month)
SERPAPI_KEY=your_serpapi_key_here
